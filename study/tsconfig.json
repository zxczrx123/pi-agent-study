{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../pi/node_modules/@types"],
    "paths": {
      "@earendil-works/pi-ai": ["../pi/packages/ai/src/index.ts"],
      "@earendil-works/pi-telemetry": ["../pi/packages/telemetry/src/index.ts"]
    }
  },
  "include": ["./*.ts"]
}
